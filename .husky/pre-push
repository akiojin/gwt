#!/usr/bin/env sh

set -e

# git は hook 子プロセスへ GIT_DIR / GIT_INDEX_FILE などを export する。
# それらが hook 配下の subprocess (tempdir に対する git 操作等) へ継承される
# と、その git 操作が本リポジトリ自身に向いてしまう。ここでの検証は
# リポジトリ自身の git 状態に依存しないので、一律に unset しておく。
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX \
    GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
    GIT_NAMESPACE GIT_COMMON_DIR

# SPEC #3576: この hook は重量級の Cargo ジョブを起動しない。
#
# hook は `gwtd` ではなく `git push` の subtree で走るため、ホスト単位の
# verification lease の外側にある。以前ここに置いていた
# `cargo clippy --all-targets --all-features` と
# `cargo llvm-cov -p gwt-core -p gwt --all-features` は、lease 保持者の
# canonical 検証と並走してホストの CPU を飽和させ、wall-clock 依存 fixture の
# 偽 FAIL を誘発していた。加えて保持者の子プロセスを見て「遊んでいる」と
# 誤読させる原因にもなっていた。#4339 で全 worktree が hook を
# materialize するようになり、push のたびにこれが起きる状態になった。
#
# 除去した検査は PR ごとに CI が同等以上の範囲で強制している。
# clippy / fmt / markdownlint / frontmatter は Lint workflow
# (`cargo clippy --workspace`)、テストは Test workflow
# (`cargo test --workspace --all-features`)、カバレッジ 90% 閾値は
# Coverage workflow が担当する。したがってここでの実行は二重であり、
# gate を緩めずに重複だけを落とせる。
#
# ここに残すのはコンパイルを伴わない高速な検査だけにすること。
# 契約は scripts/verify-husky-hooks.sh が固定している。

echo "Running fast pre-push checks..."

cargo fmt --all -- --check
# `tasks/` はリポジトリの info/exclude で git 無視されるローカル作業領域
# （AGENTS.md が tasks/todo.md の使用を指示している）。追跡対象でない
# scratch を lint して push を止めないよう、ディレクトリごと除外する。
bunx --bun markdownlint-cli . --config .markdownlint.json --ignore target --ignore CHANGELOG.md --ignore tasks
bash scripts/validate-skill-frontmatter.sh

echo "All pre-push checks passed."
