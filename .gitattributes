# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf
.docker/entrypoint.sh text eol=lf

# Dockerfile should always use LF
Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker-compose.yaml text eol=lf

# Source code files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# W-33 (SPEC-2359): immutable `.gwt/work/events/*.jsonl` shards intentionally
# use Git's default merge behavior. The union rule below is retained only for
# the frozen read-only compatibility history in the legacy monolith.
**/.gwt/work/events.jsonl merge=union
**/.gwt/work/board-remote-roots.jsonl merge=union
